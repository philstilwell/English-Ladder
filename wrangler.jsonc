{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "englishladder",
  "account_id": "35f54f15edb91fa1d38da7b8eb7583f5",
  "compatibility_date": "2026-07-02",
  "workers_dev": true,
  "preview_urls": true,
  "build": {
    "command": "npm run check:js && python3 audit_site.py && python3 audit_seo.py && node cloudflare/build.cjs"
  },
  "assets": {
    "directory": "./.cf-site",
    "html_handling": "none",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "englishladder.com",
      "custom_domain": true
    },
    {
      "pattern": "www.englishladder.com",
      "custom_domain": true
    }
  ]
}
