{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "englishladder-students",
  "account_id": "35f54f15edb91fa1d38da7b8eb7583f5",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-08",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "FEEDBACK_STORE",
        "class_name": "FeedbackStore"
      },
      {
        "name": "QUIZ_AUTOMATION",
        "class_name": "QuizAutomation"
      },
      {
        "name": "STUDENT_DIRECTORY",
        "class_name": "StudentDirectory"
      }
    ]
  },
  "migrations": [
    {
      "tag": "feedback-v1",
      "new_sqlite_classes": [
        "FeedbackStore"
      ]
    },
    {
      "tag": "quiz-automation-v1",
      "new_sqlite_classes": [
        "QuizAutomation"
      ]
    },
    {
      "tag": "student-directory-v1",
      "new_sqlite_classes": [
        "StudentDirectory"
      ]
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "AUTOMATION_ENABLED": "true"
  },
  "triggers": {
    "crons": [
      "0 5,6 * * *"
    ]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "routes": [
    {
      "pattern": "kh26.englishladder.com",
      "custom_domain": true
    },
    {
      "pattern": "phil.englishladder.com",
      "custom_domain": true
    },
    {
      "pattern": "*.englishladder.com/*",
      "zone_name": "englishladder.com"
    }
  ],
  "ratelimits": [
    {
      "name": "PRACTICE_LIMITER",
      "namespace_id": "2026101501",
      "simple": { "limit": 90, "period": 60 }
    },
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "2026101401",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "ACCOUNT_LIMITER",
      "namespace_id": "2026101402",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}
