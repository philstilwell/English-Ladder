{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "englishladder-students",
  "account_id": "35f54f15edb91fa1d38da7b8eb7583f5",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-08",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "routes": [{ "pattern": "kh26.englishladder.com", "custom_domain": true }],
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "2026101401", "simple": { "limit": 5, "period": 60 } },
    { "name": "ACCOUNT_LIMITER", "namespace_id": "2026101402", "simple": { "limit": 20, "period": 60 } }
  ]
}
